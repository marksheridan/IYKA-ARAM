# ─── IYKA-ARAM Wellness — environment variables ───
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# PostgreSQL connection (managed Postgres — Neon, Supabase, etc.)
# Used by Prisma (CLI + runtime driver adapter).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ─── Auth.js (wired in Phase 3) ───
# AUTH_SECRET="generate with: npx auth secret"
# AUTH_URL="http://localhost:3000"

# ─── WhatsApp Business API (wired in the final phase) ───
# Provided by the chosen BSP (AiSensy / Interakt / Gupshup).
# WHATSAPP_API_BASE=""
# WHATSAPP_API_KEY=""
# WHATSAPP_PHONE_NUMBER_ID=""

# ─── Phased launch gates ───
# The store and blog are built but ship dark until their phases go live.
# Unset or "false" redirects those routes to the homepage (and 404s
# /api/orders). Set to "true" and redeploy to open a section.
# STORE_LIVE="false"
# BLOG_LIVE="false"

# ─── Front-desk enquiry email (Phase 1 booking) ───
# Gmail App Password on the clinic mailbox — the site sends from and to this
# address. Requires 2-Step Verification on the account, then:
# Google Account → Security → App passwords → generate → paste below.
# Unset, enquiries are logged to the server console instead of emailed.
# SMTP_USER="yonawellnessandhealthcare@gmail.com"
# SMTP_PASS="xxxx xxxx xxxx xxxx"
# MAIL_TO="yonawellnessandhealthcare@gmail.com"   # defaults to business.email
