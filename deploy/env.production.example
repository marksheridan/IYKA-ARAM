# IYKA-ARAM — production .env for the droplet.
#
# Copy to /srv/iyka-web/.env, fill in, then lock it down:
#   chmod 600 /srv/iyka-web/.env
#   chown iyka:iyka /srv/iyka-web/.env
#
# Next reads this file itself at startup. Restart after any change:
#   sudo systemctl restart iyka-web

# ── Phase 1: front-desk enquiry email (the booking pipeline) ────────────────
# Gmail App Password on the CLINIC mailbox — not a personal account, and not
# the account login password. Requires 2-Step Verification, then
# Google Account → Security → App passwords.
# Leave these unset and enquiries print to the journal instead of being sent.
SMTP_USER="yonawellnessandhealthcare@gmail.com"
SMTP_PASS=""
MAIL_TO="yonawellnessandhealthcare@gmail.com"

# ── Admin backoffice ───────────────────────────────────────────────────────
# Generate ADMIN_SECRET with: openssl rand -base64 32
ADMIN_PASSWORD=""
ADMIN_SECRET=""

# ── Database ───────────────────────────────────────────────────────────────
# Phase 1 does not read this — no public route touches Postgres. It is still
# needed by /api/health and by the gated store/blog/admin/MIS routes.
DATABASE_URL=""

# ── Phase 2 launch gates ───────────────────────────────────────────────────
# Leave unset (or "false") for Phase 1. Set to "true" and redeploy to open a
# section; then restore its link in src/components/site/site-footer.tsx and
# drop its disallow line from src/app/robots.ts.
# COMING_SOON="false"   # "true" serves the launching-soon splash at / and
#                       # redirects the inner pages back to it. The booking
#                       # pop-up keeps working throughout.
# STORE_LIVE="false"
# BLOG_LIVE="false"
